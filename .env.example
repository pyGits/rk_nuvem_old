# Copie para .env na VPS (em /opt/rk_nuvem/.env) e preencha.
# Este arquivo NÃO deve conter segredos reais — o .env real nunca vai para o git.

# ---------------------------------------------------------------- imagens
# Prefixo das imagens no GHCR. O workflow publica <prefixo>-backend e <prefixo>-front.
# Use o dono/repositório em MINÚSCULAS.
IMAGE_PREFIX=ghcr.io/pygits/rk_nuvem_old
IMAGE_TAG=latest

# ---------------------------------------------------------------- domínios
# Cada um precisa bater com o diretório em /etc/letsencrypt/live/<dominio>/
DOMAIN=rknuvem.com.br
# O container nginx assume as 3 vhosts que hoje rodam no nginx do host.
DOMAIN_HOMOLOG=homologacao.rknuvem.com.br
DOMAIN_DEDIET=vps47862.publiccloud.com.br

# Porta em que o backend é publicado no loopback do host (o nginx roda em
# network_mode: host e o alcança por 127.0.0.1).
BACKEND_PORT=3001

# Portas do nginx. Use 8080/8443 para validar com o nginx do host ainda no ar;
# troque para 80/443 na virada, depois de parar o nginx do host.
HTTP_PORT=80
HTTPS_PORT=443

# Porta HTTPS legada da API, usada pelo agente RKNuvem instalado nas lojas.
# O endereço está compilado no executável de cada cliente (https://<dominio>:3000/api),
# então em produção esta porta NÃO pode mudar. Para validar sem conflito, use
# outra porta (ex.: 8000) junto com HTTP_PORT/HTTPS_PORT alternativos.
API_PORT=3000

# ---------------------------------------------------------------- banco
# PostgreSQL roda no host da VPS, fora do Docker.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-aqui
DB_NAME=erp

# ---------------------------------------------------------------- SEFAZ
# 1 = Produção, 2 = Homologação
SEFAZ_TP_AMB=1
SEFAZ_SCHEDULER_ENABLED=true
# Intervalo entre sincronizações por loja (ms). 3600000 = 1 hora
SEFAZ_SYNC_INTERVAL_MS=3600000
SEFAZ_TIMEOUT=60000
# Usados apenas na emissão com QR Code (NFC-e)
SEFAZ_CSC=
SEFAZ_CSC_ID=
