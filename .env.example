# Copie para .env na VPS (em /opt/rk_nuvem/.env) e preencha.
# Este arquivo NÃO deve conter segredos reais — o .env real nunca vai para o git.

# ---------------------------------------------------------------- imagens
# Prefixo das imagens no GHCR. O workflow publica <prefixo>-backend e <prefixo>-front.
# Use o dono/repositório em MINÚSCULAS.
IMAGE_PREFIX=ghcr.io/pygits/rk_nuvem_old
IMAGE_TAG=latest

# ---------------------------------------------------------------- domínio
# Precisa bater com o diretório em /etc/letsencrypt/live/<DOMAIN>/
DOMAIN=rknuvem.com.br

# ---------------------------------------------------------------- banco
# PostgreSQL roda no host da VPS, fora do Docker.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-aqui
DB_NAME=erp

# ---------------------------------------------------------------- SEFAZ
# 1 = Produção, 2 = Homologação
SEFAZ_TP_AMB=1
SEFAZ_SCHEDULER_ENABLED=true
# Intervalo entre sincronizações por loja (ms). 3600000 = 1 hora
SEFAZ_SYNC_INTERVAL_MS=3600000
SEFAZ_TIMEOUT=60000
# Usados apenas na emissão com QR Code (NFC-e)
SEFAZ_CSC=
SEFAZ_CSC_ID=
