unit Funcionario;

interface
uses
  system.SysUtils,Funcoes,system.JSON,rest.json;

type TFuncionario = class
  private
    Femail: string;
    Fapelido: string;
    Fcodigo: string;
    Fcpf: string;
    Fcomissao: currency;
    Fsenha: string;
    Fcargo: integer;
    Fnome: string;
    procedure Setapelido(const Value: string);
    procedure Setcargo(const Value: integer);
    procedure Setcodigo(const Value: string);
    procedure Setcomissao(const Value: currency);
    procedure Setcpf(const Value: string);
    procedure Setemail(const Value: string);
    procedure Setnome(const Value: string);
    procedure Setsenha(const Value: string);
  public
  property codigo:string read Fcodigo write Setcodigo;
  property nome:string read Fnome write Setnome;
  property apelido:string read Fapelido write Setapelido;
  property email:string read Femail write Setemail;
  property cpf:string read Fcpf write Setcpf;
  property cargo:integer read Fcargo write Setcargo;
  property senha:string read Fsenha write Setsenha;
  property comissao:currency read Fcomissao write Setcomissao;

  function JsonToFuncionario(const AJson: string):TFuncionario;


end;

implementation

{ TFuncionario }

function TFuncionario.JsonToFuncionario(const AJson: string): TFuncionario;
var
  LJsonObj: TJSONObject;
  LFuncionario: TFuncionario;
begin
  LJsonObj := TJSONObject.ParseJSONValue(AJson) as TJSONObject;
  try
    LFuncionario := TJson.JsonToObject<TFuncionario>(AJson);
    LFuncionario.codigo := LJsonObj.GetValue('codigo').Value;
    LFuncionario.nome := LJsonObj.GetValue('nome').Value;
    LFuncionario.apelido := LJsonObj.GetValue('apelido').Value;
    LFuncionario.email:= LJsonObj.GetValue('email').Value;
    LFuncionario.cpf := LJsonObj.GetValue('cpf').Value;
    LFuncionario.cargo := StrToInt(LJsonObj.GetValue('cargo').Value);
    LFuncionario.senha := LJsonObj.GetValue('senha').Value;
    LFuncionario.comissao := StrToFloat(LJsonObj.GetValue('icms').Value);
    Result := LFuncionario;
  finally
    LJsonObj.Free;
  end;
end;

procedure TFuncionario.Setapelido(const Value: string);
begin
  Fapelido := Value;
end;

procedure TFuncionario.Setcargo(const Value: integer);
begin
  Fcargo := Value;
end;

procedure TFuncionario.Setcodigo(const Value: string);
begin
  Fcodigo := Value;
end;

procedure TFuncionario.Setcomissao(const Value: currency);
begin
  Fcomissao := Value;
end;

procedure TFuncionario.Setcpf(const Value: string);
begin
  Fcpf := Value;
end;

procedure TFuncionario.Setemail(const Value: string);
begin
  Femail := Value;
end;

procedure TFuncionario.Setnome(const Value: string);
begin
  Fnome := Value;
end;

procedure TFuncionario.Setsenha(const Value: string);
begin
  Fsenha := Value;
end;

end.
