begin

  inherited;
end;

function TCliente.JsonToCliente(const AJson: string): TCliente;
var
  LJsonObj: TJSONObject;
  LCliente: TCliente;
begin
  LJsonObj := TJSONObject.ParseJSONValue(AJson) as TJSONObject;
  try
    LCliente := TJson.JsonToObject<TCliente>(AJson);
    LCliente.codigo := LJsonObj.GetValue('codigo').Value;
    LCliente.nome := LJsonObj.GetValue('nome').Value;
    LCliente.fantasia := LJsonObj.GetValue('fantasia').Value;
    LCliente.Observacao :=  LJsonObj.GetValue('observacao').Value;
    LCliente.cnpjcpf := LJsonObj.GetValue('cnpjcpf').Value;
    LCliente.telefone1 := LJsonObj.GetValue('telefone').Value;
    LCliente.telefone2 := LJsonObj.GetValue('telefone2').Value;
    LCliente.celular := LJsonObj.GetValue('celular').Value;
    LCliente.email:= LJsonObj.GetValue('email').Value;
    LCliente.endereco := LJsonObj.GetValue('logradouro').Value;
    LCliente.cidade := LJsonObj.GetValue('cidade').Value;
    LCliente.uf := LJsonObj.GetValue('uf').Value;
    LCliente.cep := LJsonObj.GetValue('cep').Value;
    LCliente.bairro := LJsonObj.GetValue('bairro').Value;
    LCliente.complemento := LJsonObj.GetValue('complemento').Value;
    LCliente.perc_desconto := StrToFloat(LJsonObj.GetValue('perc_desconto').Value);
    LCliente.utiliza_preco2 := (LJsonObj.GetValue('utiliza_preco2').Value);
    Result := LCliente;
  finally
    LJsonObj.Free;
  end;
end;

