unit ClienteAPIRepository;

interface
uses System.Generics.Collections,ClienteModel,uAPIRequest,System.Classes,System.JSON,System.SysUtils;
type IClienteApiRepository = interface
  ['{7AF6A5E0-A0D8-4CC1-9BF5-4BDE563E6B6A}']
